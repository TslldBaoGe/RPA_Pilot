{
  "name": "rpa-pilot",
  "version": "0.1.7",
  "private": true,
  "description": "本地 Python 任务管理客户端（Electron + Vue3）",
  "author": "RPA_Pilot Team",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fetch-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "cross-env RPA_PILOT_ROOT=D:/RPA_Pilot electron out/main/index.js --smoke",
    "selftest": "cross-env RPA_PILOT_ROOT=D:/RPA_Pilot electron out/main/index.js --selftest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "build:win": "pnpm build && node scripts/prefetch-builder-tools.mjs && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "build:win:ci": "pnpm build && electron-builder --win",
    "publish:update": "node scripts/publish-update.mjs",
    "update:server": "node scripts/update-server.mjs",
    "release:check": "node scripts/check-release-config.mjs",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
